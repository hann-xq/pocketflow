# Application
PORT=3000

# JWT
JWT_SECRET=change-me-to-a-long-random-string

# Encryption
# 64-character hex string (32 bytes). Used to encrypt sensitive columns at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=pocketflow

# ABN AMRO Sandbox API
ABN_AMRO_API_URL=https://api-sandbox.abnamro.com
# Authorization endpoint. The user is redirected here to grant consent.
ABN_AMRO_AUTH_URL=https://auth-sandbox.abnamro.com/as/authorization.oauth2
# Token endpoint. Used to exchange the authorization code for an access token.
ABN_AMRO_TOKEN_URL=https://auth-mtls-sandbox.abnamro.com/as/token.oauth2
ABN_AMRO_CLIENT_ID=TPP_test
ABN_AMRO_API_KEY=your_api_key
# Paths to your mTLS certificate and private key (PEM format). Required for production; optional for sandbox.
ABN_AMRO_CERT_PATH=./certs/PSD2TPPCertificate.crt
ABN_AMRO_KEY_PATH=./certs/PSD2TPPprivateKey.key
# ABN AMRO sandbox hardcodes https://localhost/auth as the redirect URI (cannot be changed).
ABN_AMRO_REDIRECT_URI=https://localhost/auth
ABN_AMRO_SCOPE=psd2:account:transaction:read
# Pre-configured access token. If set, skips the OAuth2 flow entirely.
# Obtain one by completing the flow once and copying the token from the callback response.
ABN_AMRO_ACCESS_TOKEN=
